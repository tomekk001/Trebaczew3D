{
  "name": "trebaczew",
  "version": "1.0.0",
  "description": "Symulator życia w Trębaczewie - wersja na komputer",
  "main": "main.js",
  "author": "trebaczew.io",
  "private": true,
  "scripts": {
    "prepare-game": "node prepare.js",
    "start": "electron .",
    "dist": "electron-builder --win --x64 --publish never"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8",
    "three": "0.128.0"
  },
  "build": {
    "appId": "io.trebaczew.gra",
    "productName": "Trebaczew",
    "files": ["main.js", "game/**"],
    "directories": { "output": "dist" },
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }], "icon": "icon.png" },
    "mac": { "target": [{ "target": "dmg", "arch": ["universal"] }], "icon": "icon.png", "identity": "-", "category": "public.app-category.games", "artifactName": "Trebaczew-Mac.dmg" },
    "nsis": { "oneClick": true, "perMachine": false, "artifactName": "Trebaczew-Setup.exe", "shortcutName": "Symulator życia w Trębaczewie" }
  }
}
